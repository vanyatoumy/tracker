# Copy this file to .env and adjust for your environment.
# .env is gitignored — never commit real secrets.
# None of these are required to run the app locally; every value has a
# sane default (see config.js). Set them explicitly in staging/production.

# Environment name. Controls the session cookie's `secure` flag by default
# (HTTPS-only when "production") and whether internal error details are
# hidden from API responses.
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# Absolute or relative path to the SQLite database file. In production,
# point this at a persistent volume (see README "Deployer ailleurs qu'en
# local") so data survives redeploys.
# DB_PATH=/data/tracker.db

# How many days a login session stays valid.
SESSION_DURATION_DAYS=30

# Force the session cookie's `secure` flag on/off, overriding the
# NODE_ENV-based default. Only needed if TLS is terminated upstream (reverse
# proxy / load balancer) in a way that confuses that default.
# COOKIE_SECURE=true

# Set to true when running behind a reverse proxy / load balancer (Railway,
# Render, Fly.io, nginx, etc.) so the app reads the real client IP from
# X-Forwarded-For. Needed for rate limiting to work correctly.
# TRUST_PROXY=true

# Login/registration rate limiting: max attempts per IP within the window.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MIN=15

# --- Subscription (manual payment) ---
# Every time an admin activates an account (new signup or renewal), it gets
# this many days of access before being auto-deactivated on next login.
SUBSCRIPTION_DURATION_DAYS=30

# Free trial: new sign-ups get this many days of full access right away,
# without paying or waiting for activation. 0 = no trial (accounts wait for
# the admin's activation after payment).
FREE_TRIAL_DAYS=30

# Days after expiry during which the account stays readable (read-only,
# with a renewal banner) before access is cut off. 0 = cut off at expiry.
SUBSCRIPTION_GRACE_DAYS=3

# Plain text shown to users in the app — no payment gateway, this is just
# what tells them how/where to pay you directly (Mobile Money, etc.) before
# you activate their account. Leave unset to hide the panel entirely.
# SUBSCRIPTION_PRICE=2000 FCFA / mois
# SUBSCRIPTION_PAYMENT_INSTRUCTIONS=Envoie le montant via Orange Money au 6XX XXX XXX, puis envoie la capture d'ecran de paiement au contact ci-dessous.
# SUBSCRIPTION_CONTACT=WhatsApp +237 6XX XXX XXX

# --- Backups (see README "Sauvegardes") ---

# Where local backup snapshots are written before optional offsite push.
# BACKUP_DIR=/data/backups

# How many days of local backups to keep (older ones are deleted by
# scripts/backup.js on each run).
BACKUP_RETENTION_DAYS=14

# Optional rsync/scp target for offsite copies, e.g.
# user@backup-host:/srv/backups/mlm-tracker/
# Requires passwordless SSH key auth already set up on the host. If unset,
# backups stay local only (not recommended for production).
# BACKUP_REMOTE=user@backup-host:/srv/backups/mlm-tracker/
